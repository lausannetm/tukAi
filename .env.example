# Copy to ".env" in this folder and fill in values. Docker Compose loads ".env" automatically
# when you run `docker compose` from the project root (same directory as docker-compose.yml).

# Required for AI search (POST /services/suggest → hero "Search catalog").
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: OpenAI model for hero search (default gpt-4o-mini). See https://platform.openai.com/docs/models
# OPENAI_MODEL=gpt-4o-mini

# Zero-cost demo: set to 1 to skip OpenAI and pick a service locally (text + rating + distance).
# Docker Compose: set here so the `backend` container sees it (host `npm run dev` env does not apply).
# Local `next dev` in ./backend: mock runs automatically when OPENAI_API_KEY is empty (no flag needed).
# Use OPENAI_MOCK_SUGGEST=0 to force the real OpenAI path in dev (will 503 if the key is missing).
OPENAI_MOCK_SUGGEST=0

# Frontend (browser): API base for login/register — must be the backend origin (default port 3001), not the frontend.
# NEXT_PUBLIC_BACKEND_PUBLIC_URL=http://localhost:3001

# Required for JWT auth (POST /auth/register, /auth/login, GET /auth/me). Use a long random string in production.
# JWT_SECRET=

# Service listing images (POST /services/upload). Docker uses a named volume; local dev writes to backend/uploads/services.
# SERVICE_UPLOADS_DIR=./uploads/services

# Local frontend: server proxy `app/backend/[...path]` forwards /backend/* to BACKEND_INTERNAL_URL (see frontend/app/backend).
# BACKEND_INTERNAL_URL=http://127.0.0.1:3001

# MailHog (docker compose): web UI http://localhost:8025 — catches SMTP on host port 1025 (service hostname `mailhog`, port 1025 from backend).
# MAILHOG_UI_PORT=8025
# MAILHOG_SMTP_PORT=1025

# SMTP (backend → MailHog). In Docker, SMTP_HOST=mailhog works. On your laptop (`next dev` for backend), use 127.0.0.1 and run MailHog: `docker compose up -d mailhog`.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
# SMTP_FROM=noreply@localhost
